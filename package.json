{
  "name": "aireleasekit",
  "version": "0.1.0",
  "private": true,
  "description": "Turn PRDs, prompts, RAG docs, and agent tool schemas into executable AI release gates.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --sort build",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "demo": "pnpm --filter @aireleasekit/cli airelease demo",
    "typecheck": "pnpm -r --sort typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
