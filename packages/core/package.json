{
  "name": "@aireleasekit/core",
  "version": "0.1.0",
  "description": "Core generation, scoring, running, scanning, and reporting engine for AIReleaseKit.",
  "author": "choose-hy",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/choose-hy/aireleasekit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/choose-hy/aireleasekit#readme",
  "bugs": {
    "url": "https://github.com/choose-hy/aireleasekit/issues"
  },
  "keywords": [
    "llm",
    "evals",
    "ai-release-gates",
    "rag",
    "agent-safety",
    "red-teaming",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  }
}
